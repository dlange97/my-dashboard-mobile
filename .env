# Expo public env vars – must start with EXPO_PUBLIC_
#
# Android emulator: 10.0.2.2 maps to the host machine (your Mac)
# iOS Simulator:    localhost or 127.0.0.1
# Physical device:  your Mac's LAN IP, e.g. 192.168.1.x
#
# The nginx API gateway runs on port 80 (see my-dashboard-docker/docker-compose.yml)
#
# ⚠️  DEV ONLY — HTTP is acceptable for the Android emulator (localhost loopback).
#     NEVER use http:// in a production or release build.
#     For production, copy .env.production and set EXPO_PUBLIC_API_URL=https://your-domain.

EXPO_PUBLIC_API_URL=http://10.0.2.2
